{
  "name": "@grocery/web-spa-e2e",
  "private": true,
  "description": "Playwright end-to-end tests for apps/web-spa, run against the real app with disposable Docker infra.",
  "type": "module",
  "scripts": {
    "e2e:infra": "docker compose -f ../../docker-compose.e2e.yml -p grocery-e2e up -d --wait",
    "e2e:down": "docker compose -f ../../docker-compose.e2e.yml -p grocery-e2e down",
    "e2e:setup": "tsx ./scripts/reset-db.ts",
    "e2e": "pnpm e2e:infra && playwright test",
    "e2e:dev": "pnpm e2e:infra && playwright test --ui",
    "e2e:show": "playwright show-report",
    "e2e:codegen": "playwright codegen http://localhost:5273",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "catalog:e2e",
    "@types/node": "catalog:build",
    "dotenv": "catalog:e2e",
    "tsx": "^4.23.5",
    "typescript": "catalog:build"
  }
}
