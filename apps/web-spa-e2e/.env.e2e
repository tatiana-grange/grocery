# Environnement du run e2e de la web-spa. Committé volontairement : aucun secret réel,
# l'infra est jetable (docker-compose.e2e.yml). Ces valeurs sont superposées à process.env ;
# l'API complète les trous depuis apps/api/.env.example quand NODE_ENV=test.
# Ports dédiés + hôte 127.0.0.1 (le dev-server Vite se lie en IPv6 par défaut, ce qui casse
# les navigations Playwright vers localhost/127.0.0.1).

NODE_ENV=test
# Monte `TestSeedModule` (route destructive `POST /api/test/seed/reset`). Uniquement ici :
# les suites vitest de l'API tournent aussi avec NODE_ENV=test.
E2E=true

# API (processus hôte)
API_PORT=3060
API_HOST=127.0.0.1
API_BASE_URL=http://127.0.0.1:3060
BETTER_AUTH_SECRET=e2e_secret_key_not_used_in_prod_min_32_chars
TRUSTED_ORIGINS=http://127.0.0.1:3060,http://127.0.0.1:5273
CLIENTS_WEB_APP_URL=http://127.0.0.1:5273

# Base de données (docker-compose.e2e.yml `db`, publiée sur 5434)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5434
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=grocery_e2e

# Email -> maildev (docker-compose.e2e.yml `maildev`, ports dédiés 1090/1035)
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1035
EMAIL_SECURE=false
EMAIL_FROM=e2e@example.com

# SMS : pas de provider, les codes sont loggés dans la console de l'API
SMS_PROVIDER=
SMS_FROM=

# Cotisation par défaut
MEMBERSHIP_FEE_DEFAULT_CENTS=0

# web-spa (serveur de dev)
VITE_API_URL=http://127.0.0.1:3060
HOST=127.0.0.1

# API REST de maildev (maildev.ts lit les mails)
MAILDEV_URL=http://127.0.0.1:1090
