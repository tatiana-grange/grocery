# APP
API_PORT=3000
API_BASE_URL=http://localhost:3000

BETTER_AUTH_SECRET=your_secret_here_min_32_chars_use_openssl_rand_base64_32
CLIENTS_WEB_APP_URL=http://localhost:5173
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# DATABASE
DATABASE_PASSWORD=postgres
DATABASE_USER=postgres
DATABASE_NAME=grocery
DATABASE_HOST=localhost
DATABASE_PORT=5111

# Email Configuration (MailDev)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_FROM=noreply@localhost.com

# SMS (phone-number one-time codes). Leave SMS_PROVIDER empty in dev: codes are logged to the API console.
SMS_PROVIDER=
SMS_FROM=

# Members
MEMBERSHIP_FEE_DEFAULT_CENTS=0

# Online payments (HelloAsso). All optional: leave them empty and online top-up is off.
# PAYMENT_PROVIDER is helloasso or fake. fake is a test double and is ignored in production.
# Unset means helloasso, which needs the client id, the secret and the organisation slug.
# HELLOASSO_API_URL defaults to the sandbox, https://api.helloasso-sandbox.com/v5.
# Production must name https://api.helloasso.com/v5 on purpose.
PAYMENT_PROVIDER=
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
HELLOASSO_ORGANIZATION_SLUG=
HELLOASSO_API_URL=

# Sentry
SENTRY_DSN=

# Optional feature flags. isFeatureEnabled('example') reads FEATURE_EXAMPLE.
# FEATURE_EXAMPLE=true
