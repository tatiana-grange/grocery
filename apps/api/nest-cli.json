{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "builder": {
      "type": "swc",
      "options": {
        "extensions": [".js", ".ts", ".tsx"]
      }
    },
    "assets": [
      {
        "include": "modules/email/templates/static/**/*",
        "outDir": "dist"
      }
    ],
    "watchAssets": true
  }
}
